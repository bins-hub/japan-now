{
  "rules": {
    "presence": {
      "v1": {
        ".read": "auth != null",
        "$uid": {
          "$connection": {
            ".write": "auth != null && auth.uid === $uid && (newData.val() === true || !newData.exists())",
            ".validate": "newData.val() === true"
          }
        }
      }
    }
  }
}
